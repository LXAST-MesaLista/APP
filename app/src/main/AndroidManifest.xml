<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Avisos de las reservas (Android 13+ pide permiso al usuario). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para abrir PayPal en una pestaña del navegador (Custom Tabs). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- Sin copias de seguridad en la nube: el token de la sesión no sale del móvil. -->
    <application
        android:name=".MesaListaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_copia"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MesaLista.Inicio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Vuelta de PayPal: el servidor redirige a mesalista://reserva/{id}?pago=… (RF-44). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mesalista" android:host="reserva" />
            </intent-filter>
        </activity>

        <!-- Avisos push (FCM): token nuevo y avisos que llegan con la app abierta. -->
        <service
            android:name=".AvisosServicio"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Con la app cerrada, el sistema muestra el aviso: en el canal «Reservas», con este icono y color. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reservas" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_aviso" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/bar" />
    </application>
</manifest>
