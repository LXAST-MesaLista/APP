<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la ventana; los colores de las pantallas los pone Compose (ui/tema). -->
    <style name="Theme.MesaLista" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <!-- Pantalla de inicio (SplashScreen de Android 12, compatible hacia atrás). -->
    <style name="Theme.MesaLista.Inicio" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bar</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MesaLista</item>
    </style>
</resources>
