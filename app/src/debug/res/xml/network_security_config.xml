<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en la versión debug: HTTP sin cifrar únicamente hacia 10.0.2.2 (la API
     de desarrollo de este ordenador vista desde el emulador). La versión release
     usa el archivo de src/main, que solo permite HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
